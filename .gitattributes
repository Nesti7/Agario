# Git-crypt конфигурация
# Шифруем весь код и конфиги

# Код
*.js filter=git-crypt diff=git-crypt
*.html filter=git-crypt diff=git-crypt
*.css filter=git-crypt diff=git-crypt
*.json filter=git-crypt diff=git-crypt

# Конфиги и важные файлы
*.txt filter=git-crypt diff=git-crypt
.cursorrules filter=git-crypt diff=git-crypt

# НЕ шифруем
README.md -filter
.gitignore -filter
.gitattributes -filter
LICENSE -filter

